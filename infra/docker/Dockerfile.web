# syntax=docker/dockerfile:1.7
#
# Dashboard image, built on Next.js standalone output.
#
# `output: 'standalone'` traces the module graph and emits a server bundling only what is
# actually imported. That is the difference between a ~1.2GB image carrying the full
# node_modules tree and one well under 200MB.

FROM node:22-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/core/package.json ./packages/core/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/telemetry/package.json ./packages/telemetry/
COPY packages/db/package.json ./packages/db/
COPY apps/gateway/package.json ./apps/gateway/
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/
RUN npm ci --ignore-scripts

FROM deps AS build
COPY apps/web ./apps/web
# Baked in at build time: Next inlines NEXT_PUBLIC_* into the client bundle, so this is the
# URL the *browser* will call — it must be reachable from the user's machine, not from the
# container. Override at build time for non-local deployments.
ARG GATEWAY_URL=http://localhost:8080
ENV GATEWAY_URL=$GATEWAY_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build --workspace @halcyon/web

FROM base AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S halcyon && adduser -S halcyon -G halcyon

COPY --from=build --chown=halcyon:halcyon /app/apps/web/.next/standalone ./
COPY --from=build --chown=halcyon:halcyon /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=halcyon:halcyon /app/apps/web/public ./apps/web/public

USER halcyon
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "apps/web/server.js"]
